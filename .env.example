# TREK Guest Portal companion configuration example
# Copy this file to .env and replace the example values before starting the container.

TREK_DOCKER_NETWORK=<exact-trek-network-name>
TREK_HOST=app
TREK_PORT=3000
UPSTREAM_TIMEOUT=20

GUEST_PORTAL_UID=65532
GUEST_PORTAL_GID=65532
GUEST_PORTAL_BIND_IP=127.0.0.1

PUBLIC_ORIGIN=https://guest.example.com
TREK_PUBLIC_ORIGIN=https://trek.example.com
# URL base path when the companion is mounted under a prefix (e.g. /guest-plugin/).
# Must start and end with a slash.
GUEST_PLUGIN_PATH=/guest-plugin/
COOKIE_PATH=/

# IANA timezone for X-WR-TIMEZONE in iCal feeds (e.g. America/New_York, Europe/London).
ICAL_TIMEZONE=UTC

SESSION_TTL_SECONDS=0
SESSION_COOKIE_MAX_AGE_SECONDS=315360000
SESSION_MAX=2048
SESSION_CREATE_PER_MINUTE=120

LOG_LEVEL=INFO
LOG_FORMAT=kv
FULL_LOGGING=true
LOG_STATIC_REQUESTS=true
LOG_SAFE_REQUEST_HEADERS=true
CLIENT_EVENT_LOGGING=true
CLIENT_EVENT_RATE_PER_MINUTE=240
CLIENT_EVENT_MAX_BODY=8192
LOG_HEARTBEAT_SECONDS=300
LOG_CLIENT_IP=false
TRUST_PROXY_HEADERS=false
CLIENT_IP_HEADER=X-Guest-Client-IP
TRUSTED_PROXY_CIDRS=
LOG_PROXY_DETAILS=true

FLIGHT_API_WINDOW_HOURS=48
FLIGHT_UPCOMING_POLL_SECONDS=600
FLIGHT_ACTIVE_POLL_SECONDS=60
FLIGHT_ERROR_POLL_SECONDS=300
LIVE_FLIGHT_MAX_CACHE=256
AERODATABOX_TIMEOUT=10
AERODATABOX_MIN_INTERVAL=1.6
AERODATABOX_429_RETRIES=2
AERODATABOX_429_BACKOFF=2.5
ADSB_TIMEOUT=8
GUEST_CACHE_MAX_ROWS=512

IMMICH_URL=
IMMICH_VERIFY_TLS=true
IMMICH_TIMEOUT=15
IMMICH_DATE_CACHE_TTL=86400
PHOTO_METADATA_PREFIX_BYTES=2097152
PHOTO_DATE_CACHE_TTL=21600
